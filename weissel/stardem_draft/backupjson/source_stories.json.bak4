    "metadata_schools": "[\"Kent Island High School\", \"Parkside High School\", \"Patuxent High School\", \"Easton High School\", \"North Caroline High School\", \"La Plata High School\", \"Huntingtown High School\", \"Westlake High School\", \"Queen Anne's County High School\"]",
    "entities_quoted_people": "[\"head coach Justin Holland\", \"Gabi Bernhard\", \"Ben Marks\", \"Jed Smith\", \"Sumayah Wilkins\"]",
