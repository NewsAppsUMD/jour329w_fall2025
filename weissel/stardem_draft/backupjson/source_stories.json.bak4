    "metadata_schools": "[\"Cambridge-South Dorchester High\", \"Kent Island High\", \"Washington High School\", \"Colonel Richardson High School\", \"Easton High School\", \"Harford Tech\", \"Perryville High School\", \"North Dorchester High School\", \"Queen Anne's High School\"]",
    "entities_quoted_people": "[\"Dr. Lois Narr\", \"Sumayah Wilkins\", \"head coach Justin Holland\"]",
