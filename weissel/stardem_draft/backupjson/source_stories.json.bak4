    "metadata_teams": "[\"Archbishop Curley Friars\", \"Saints Peter and Paul Sabres\"]",
    "metadata_schools": "[\"Archbishop Curley High School\", \"Saints Peter and Paul High School\"]",
    "entities_quoted_people": "[\"head coach Todd Wolters\", \"head coach Chris Ogle\"]",
