    "metadata_story_type": "game recap",
    "metadata_location": "Easton, Maryland",
    "metadata_teams": "[\"Saints Peter and Paul High School\", \"Easton High School\"]",
    "metadata_schools": "[\"Saints Peter and Paul High School\", \"Easton High School\"]",
    "entities_quoted_people": "[\"coach Alison Beyer\", \"Caroline Ewing\", \"head coach Katie Lowman\", \"Kylie Kroniser\"]",
    "metadata_level_of_play": "high school",
    "metadata_competition_type": "regular season",
