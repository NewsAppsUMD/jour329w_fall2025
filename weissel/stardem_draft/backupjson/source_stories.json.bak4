    "metadata_story_type": "game recap",
    "metadata_location": "Stevensville, Maryland",
    "metadata_teams": "[\"Kent Island High School\", \"Stephen Decatur High School\"]",
    "metadata_schools": "[\"Kent Island High School\", \"Stephen Decatur High School\"]",
