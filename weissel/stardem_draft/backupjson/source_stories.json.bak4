    "metadata_teams": "[\"Queen Anne's County High\"]",
    "metadata_schools": "[\"Queen Anne's County High\", \"Winters Mill\", \"Manchester Valley\", \"Francis Scott Key\", \"La Plata\", \"Eastern Tech\", \"Oakland Mills\", \"Stephen Decatur\"]",
    "entities_quoted_people": "[\"David Stricker\", \"head coach John Waters\"]",
    "metadata_level_of_play": "high school",
    "metadata_competition_type": "tournament",
    "metadata_outcome": "Queen Anne's 119 points, Oakland Mills 86 points",
