      "llm_failed": false
    },
    "entities_people": "[\"Jack Brennen\", \"Jacob Seek\"]",
    "metadata_sport": "baseball",
    "metadata_story_type": "game recap",
    "metadata_location": "St. Michaels, Maryland",
    "metadata_teams": "[\"St. Michaels Saints\", \"Queen Anne's Lions\"]",
    "metadata_schools": "[\"St. Michaels High School\", \"Queen Anne's High School\"]",
    "entities_quoted_people": "[\"head coach Brian Femi\", \"head coach Chris Fitzgerald\", \"Jacob Seek\", \"Noah Palmer\"]",
    "metadata_level_of_play": "high school",
    "metadata_competition_type": "regular season",
    "metadata_outcome": "St. Michaels 3, Queen Anne's 2",
