    "metadata_schools": "[\"Easton High School\", \"Kent Island\"]",
    "entities_quoted_people": "[\"coach Matt Griffith\", \"head coach Zach Davis\", \"Mikey O'Connor\"]",
    "metadata_level_of_play": "high school",
    "metadata_competition_type": "regular season",
