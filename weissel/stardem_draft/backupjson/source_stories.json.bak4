    "metadata_teams": "[\"Easton Warriors\", \"Cambridge-South Dorchester Vikings\"]",
    "metadata_schools": "[\"Easton High School\", \"Cambridge-South Dorchester High School\"]",
    "entities_quoted_people": "[\"head coach Ryan Brice\", \"Sammy Townsend\"]",
