    "metadata_teams": "[\"Colonel Richardson High School\"]",
    "metadata_schools": "[\"Colonel Richardson High School\", \"Sussex Tech\", \"Bohemia Manor\", \"Washington\"]",
    "entities_quoted_people": "[\"James Jackson\"]",
