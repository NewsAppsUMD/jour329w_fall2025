    "metadata_schools": "[\"Kent Island High School\", \"Queen Anne's High School\", \"North Caroline High School\", \"Colonel Richardson High School\", \"Easton High School\", \"Parkside High School\", \"Stephen Decatur High School\"]",
    "entities_quoted_people": "[\"Heath Wilkins\", \"head coach Zach Davis\", \"head coach Brian Mooney\", \"head coach James Jackson\"]",
