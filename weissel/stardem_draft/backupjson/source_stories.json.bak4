    "metadata_schools": "[\"Stephen Decatur High School\", \"Parkside High School\", \"Kent Island High School\", \"North Caroline High School\", \"Colonel Richardson High School\", \"Queen Anne's County High School\"]",
    "entities_quoted_people": "[\"coach Josh August\", \"head coach Tommy Sitar\", \"head coach Bryan Hall\", \"head coach David Stricker\"]",
