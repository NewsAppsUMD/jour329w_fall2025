    "metadata_schools": "[\"Queen Anne's County High\", \"North Caroline\", \"Parkside\", \"Stephen Decatur\", \"St. Michaels\", \"Kent Island\"]",
    "entities_quoted_people": "[\"Keira Corcoran\", \"head coach Brad Niesz\"]",
