    "metadata_schools": "[\"Queen Anne's County High\", \"Kent County\", \"Stephen Decatur\", \"Kent Island\", \"James M. Bennett\"]",
    "entities_quoted_people": "[\"Nate Smith\", \"head coach Brad Niesz\", \"Quinten Joiner\"]",
