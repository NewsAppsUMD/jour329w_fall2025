    "metadata_teams": "[\"Decatur Seahawks\", \"Kent Island Buccaneers\", \"Harford Vo-Tech\"]",
    "metadata_schools": "[\"Stephen Decatur High\", \"Kent Island High School\", \"Harford Vo-Tech\"]",
    "entities_quoted_people": "[\"head coach Josh August\", \"head coach Tommy Sitar\"]",
    "metadata_level_of_play": "high school",
