    "metadata_teams": "[\"Cambridge-South Dorchester Vikings\", \"Century Knights\"]",
    "metadata_schools": "[\"Cambridge-South Dorchester High School\", \"Century High School\"]",
    "entities_quoted_people": "[\"Rob Burnham\"]",
